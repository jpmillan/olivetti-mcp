# Your Jira Cloud URL (e.g. https://myteam.atlassian.net)
JIRA_BASE_URL=https://yourteam.atlassian.net

# The email you use to log in to Jira
JIRA_EMAIL=you@example.com

# API token — generate one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# The Jira project key where tickets will be created (e.g. PROJ, DEV, ACME)
JIRA_PROJECT_KEY=DEV

# (Optional) Path to your YAML issue templates. Defaults to ./templates
# TEMPLATES_DIR=./templates
